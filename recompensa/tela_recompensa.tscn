[gd_scene format=3]

[ext_resource type="Script" path="res://recompensa/tela_recompensa.gd" id="1_recompensa"]
[ext_resource type="PackedScene" path="res://cartas/fila_cartas.tscn" id="2_fila"]

[node name="TelaRecompensa" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_recompensa")

[node name="Centro" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Linhas" type="VBoxContainer" parent="Centro"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Titulo" type="Label" parent="Centro/Linhas"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Escolha uma carta para o baralho"
horizontal_alignment = 1

[node name="Cartas" parent="Centro/Linhas" instance=ExtResource("2_fila")]
unique_name_in_owner = true
layout_mode = 2

[node name="Botao" type="Button" parent="Centro/Linhas"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
text = "Não pegar nenhuma"
